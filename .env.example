# ==============================================================================
# AI Agent Virtual Office — Enterprise Jira & Confluence Credentials
# ==============================================================================
#
# 🔒 LOCAL-ONLY PRIVACY GUARANTEE:
# These Personal Access Tokens (PATs) are processed 100% locally on your machine.
# The Python scripts (scripts/read_jira.py and scripts/read_confluence.py) use
# standard Python urllib to connect DIRECTLY to your enterprise Jira / Confluence
# instance (dm.stc.com.sa).
#
# Under NO circumstances are your tokens or ticket contents sent to any external server,
# AI model provider, or third party.
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.local (which is permanently ignored by git):
#      cp .env.example .env.local
#
# 2. Add your Personal Access Tokens below:

# Jira Personal Access Token (Jira -> User Profile -> Personal Access Tokens -> Create Token)
JIRA_PATH="your_jira_personal_access_token_here"

# Confluence Personal Access Token (Confluence -> User Profile -> Personal Access Tokens -> Create Token)
CONFLUENCE_PATH="your_confluence_personal_access_token_here"
