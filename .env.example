# ==============================================================================
# AI Agent Virtual Office — Jira & Confluence access (read-jira / read-confluence skills)
# ==============================================================================
#
# LOCAL ONLY: scripts/read_jira.py and scripts/read_confluence.py use Python urllib to talk
# DIRECTLY to the Jira / Confluence server you set below. Tokens and ticket contents are never
# sent anywhere else (no AI provider, telemetry or third party).
#
# SETUP:
# 1. Copy this file to .env.local (gitignored):
#      cp .env.example .env.local
# 2. Replace the placeholder values below with your server URLs and tokens.

# Your Jira server, e.g. https://jira.your-company.com
JIRA_BASE_URL="https://jira.example.com"
# Jira personal access token (Jira > your avatar > Profile > Personal Access Tokens > Create token)
JIRA_PATH="your_jira_personal_access_token_here"

# Your Confluence server, e.g. https://confluence.your-company.com (include /wiki if your URLs have it)
CONFLUENCE_BASE_URL="https://confluence.example.com"
# Confluence personal access token (Confluence > your avatar > Settings > Personal Access Tokens > Create token)
CONFLUENCE_PATH="your_confluence_personal_access_token_here"
